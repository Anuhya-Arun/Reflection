{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-14",
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,

  "durable_objects": {
    "bindings": [
      {
        "name": "USER_USAGE",
        "class_name": "UserUsage"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "UserUsage"
      ]
    }
  ],

  "ratelimits": [
    {
      "name": "REVIEW_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}